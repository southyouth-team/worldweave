# 生产部署环境变量示例。
# 复制为 .env.production 后修改；该文件已被 .gitignore 忽略，不要提交。
# 使用：docker compose --env-file .env.production -f docker-compose.prod.yml ...

# 域名与 HTTPS
DOMAIN=worldweave.example.com
PUBLIC_ORIGIN=https://worldweave.example.com

# 镜像来源
# 默认从 GHCR 拉取；如果你 fork 了仓库，改成自己的 GHCR 前缀。
IMAGE_PREFIX=ghcr.io/southyouth-team
# latest 或某次提交的完整 SHA；回滚时改成旧 SHA。
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_USER=worldweave
POSTGRES_DB=worldweave
# 必须改成强随机密码
POSTGRES_PASSWORD=change-me-strong-db-password

# 首次启动创建的管理员。已有管理员后不会覆盖。
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=管理员
# 必须改成强密码；首次登录会要求改密。
ADMIN_PASSWORD=change-me-strong-admin-password

# 开发环境自动执行迁移；生产也可以保持 true（单实例部署）。
# 多实例部署时改为 false，并在发布流程中单独执行迁移。
DB_MIGRATIONS_RUN=true

# 可选：AI 图像 / 模型生成
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_MODEL=
VISION_API_KEY=
VISION_API_BASE_URL=
