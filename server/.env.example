NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=ncgxy_campus_map
DB_SSL=false
DB_LOGGING=false

# 开发环境默认自动执行未应用的 TypeORM migration；生产环境默认 false，由发布流程执行 npm run db:migrate
# 如需覆盖默认策略，可显式设置 true 或 false
# DB_MIGRATIONS_RUN=true

# 开发环境请求头 X-Dev-User-Id 用于模拟登录身份；生产环境会拒绝此模式。
# 设为 false 可在本地也关闭该兼容层，强制使用账号会话。
# AUTH_ALLOW_DEV_HEADER=true

# 首次启动且数据库中没有管理员时创建初始管理员；未配置 ADMIN_PASSWORD 时，
# 开发环境使用临时密码 Admin@12345 并强制首次登录改密，生产环境不会自动创建。
# ADMIN_USERNAME=admin
# ADMIN_DISPLAY_NAME=管理员
# ADMIN_PASSWORD=change-me-please

# 本地底图文件存储目录；生产环境请挂载持久化磁盘卷
ASSET_STORAGE_DIR=./uploads

# AI 图片生成：优先使用独立配置；未设置时服务端复用 VISION_API_KEY / VISION_API_BASE_URL。
# 不需要为了图片生成重复填写同一服务的鉴权密钥。
# IMAGE_API_KEY=
# IMAGE_API_BASE_URL=
# IMAGE_MODEL=gpt-image-2
